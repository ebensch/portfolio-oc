---
/**
 * Single collapsible card inside a ProjectAccordion — header always visible
 * (number + title), body revealed on click. Uses a CSS-only grid-rows
 * expand/collapse (no JS height measuring); ProjectAccordion only toggles
 * the `is-open` class, aria-expanded and `inert` on click.
 */
import ImageFrame from "../ui/ImageFrame.astro";
import { cn } from "../../lib/cn";
import type { PlaceholderImage } from "../../types/project";

interface Props {
  id: string;
  index: number;
  title: string;
  /** Ignored when the default slot is used instead (e.g. Aperçu's rendered Markdown). */
  paragraphs?: string[];
  image?: PlaceholderImage;
  open?: boolean;
}

const { id, index, title, paragraphs = [], image, open = false } = Astro.props;
const eyebrow = String(index).padStart(2, "0");
const triggerId = `${id}-trigger`;
const panelId = `${id}-panel`;
const hasCustomContent = Astro.slots.has("default");
---

<li id={id} class={cn("accordion-item", "scroll-anchor", open && "is-open")} data-accordion-item>
  <h3 class="accordion-item__heading">
    <button
      type="button"
      id={triggerId}
      class="accordion-item__trigger"
      aria-expanded={open ? "true" : "false"}
      aria-controls={panelId}
      data-accordion-trigger
    >
      <span class="index-badge" aria-hidden="true">{eyebrow}</span>
      <span class="accordion-item__title">{title}</span>
      <svg class="accordion-item__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>
  </h3>

  <div
    id={panelId}
    role="region"
    aria-labelledby={triggerId}
    class="accordion-item__panel"
    data-accordion-panel
    inert={!open}
  >
    <div class="accordion-item__panel-inner">
      {hasCustomContent ? (
        <div class="accordion-item__body">
          <slot />
        </div>
      ) : (
        <div class={cn("accordion-item__body", image && "accordion-item__body--split")}>
          <div class="accordion-item__text">
            {paragraphs.map((paragraph) => (
              <p class="text-body-lg text-secondary">{paragraph}</p>
            ))}
          </div>
          {image && (
            <div class="accordion-item__media">
              <ImageFrame alt={image.alt} label={title} src={image.src} tone={image.tone} ratio="4/3" />
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</li>

<style>
  .accordion-item {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .accordion-item:hover {
    border-color: var(--color-border-strong);
  }

  .accordion-item.is-open {
    box-shadow: var(--shadow-md);
  }

  .accordion-item__heading {
    margin: 0;
  }

  .accordion-item__trigger {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-5) var(--space-6);
    text-align: left;
  }

  .accordion-item__title {
    flex: 1;
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    font-size: var(--text-h4);
    color: var(--color-text-primary);
  }

  .accordion-item__chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .accordion-item.is-open .accordion-item__chevron {
    transform: rotate(180deg);
    color: var(--color-accent-primary-dark);
  }

  /* CSS-only expand/collapse — animating grid-template-rows avoids
   * measuring scrollHeight in JS. */
  .accordion-item__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-slow) var(--ease-out);
  }

  .accordion-item.is-open .accordion-item__panel {
    grid-template-rows: 1fr;
  }

  .accordion-item__panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .accordion-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-6) var(--space-6);
  }

  .accordion-item__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .accordion-item__media {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .accordion-item__body--split {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
      gap: var(--space-7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-item,
    .accordion-item__chevron,
    .accordion-item__panel {
      transition: none;
    }
  }
</style>
