---
/**
 * Original hero animation: a handful of shapes (rings, dots, a tick, a
 * connecting line) drift in from scattered positions and settle into one
 * aligned composition — a quiet echo of "converging toward structure"
 * (research, business and interface aligning into one product) without
 * illustrating the Convergence project literally. Pure CSS/SVG — transform
 * and stroke-dashoffset only, so it stays GPU-cheap and fully inert under
 * `prefers-reduced-motion` (handled globally in globals.css).
 */
---

<div class="hero-visual" aria-hidden="true">
  <svg class="hero-visual__svg" viewBox="0 0 480 480" fill="none">
    <defs>
      <linearGradient id="hv-gradient" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" style="stop-color: var(--color-accent-rose)" />
        <stop offset="100%" style="stop-color: var(--color-accent-lavender)" />
      </linearGradient>
    </defs>

    <line class="hv-grid" x1="0" y1="240" x2="480" y2="240" />
    <line class="hv-grid" x1="240" y1="0" x2="240" y2="480" />

    <path class="hv-path" pathLength="1" d="M126 336 C 168 268, 268 268, 300 190 S 356 92, 356 92" />

    <circle class="hv-shape hv-shape--ring-a" cx="126" cy="336" r="30" />
    <circle class="hv-shape hv-shape--dot-a" cx="356" cy="92" r="9" />
    <circle class="hv-shape hv-shape--dot-b" cx="222" cy="300" r="5" />
    <circle class="hv-shape hv-shape--ring-b" cx="300" cy="190" r="17" />
    <line class="hv-shape hv-shape--tick" x1="372" y1="180" x2="398" y2="204" />
    <circle class="hv-shape hv-shape--dot-c" cx="150" cy="130" r="6" />
  </svg>
</div>

<style>
  .hero-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    max-width: 30rem;
    margin-inline: auto;
  }

  .hero-visual__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hv-grid {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .hv-path {
    stroke: url(#hv-gradient);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hv-draw 1.1s var(--ease-out) 500ms both;
  }

  .hv-shape {
    stroke: var(--color-accent-primary-dark);
    fill: none;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hv-shape--dot-a,
  .hv-shape--dot-b,
  .hv-shape--dot-c {
    fill: var(--color-accent-secondary-dark);
    stroke: none;
  }

  .hv-shape--ring-a {
    animation: hv-converge 900ms var(--ease-out) both, hv-float-a 8s ease-in-out 900ms infinite;
    --from-x: -70px;
    --from-y: 60px;
  }

  .hv-shape--ring-b {
    stroke: var(--color-accent-secondary-dark);
    animation: hv-converge 900ms var(--ease-out) 120ms both, hv-float-b 7s ease-in-out 1020ms infinite;
    --from-x: 60px;
    --from-y: -50px;
  }

  .hv-shape--dot-a {
    animation: hv-converge 800ms var(--ease-out) 220ms both, hv-float-a 6.5s ease-in-out 1020ms infinite;
    --from-x: 55px;
    --from-y: -70px;
  }

  .hv-shape--dot-b {
    animation: hv-converge 800ms var(--ease-out) 320ms both;
    --from-x: -40px;
    --from-y: 40px;
  }

  .hv-shape--dot-c {
    animation: hv-converge 800ms var(--ease-out) 60ms both, hv-float-b 9s ease-in-out 860ms infinite;
    --from-x: -35px;
    --from-y: -45px;
  }

  .hv-shape--tick {
    stroke: var(--color-accent-primary-dark);
    animation: hv-converge 800ms var(--ease-out) 380ms both;
    --from-x: 45px;
    --from-y: 30px;
  }

  @keyframes hv-converge {
    from {
      opacity: 0;
      transform: translate(var(--from-x), var(--from-y)) scale(0.8);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }

  @keyframes hv-draw {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 0.7;
    }
  }

  @keyframes hv-float-a {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes hv-float-b {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
</style>
