---
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Badge from "../ui/Badge.astro";
import Reveal from "../motion/Reveal.astro";

interface Props {
  eyebrow?: string;
  title: string;
  /** A single paragraph, or several lines stacked tightly (e.g. two short sentences on their own line). */
  description?: string | string[];
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
const lines = description ? (Array.isArray(description) ? description : [description]) : [];
---

<Section padding="sm" class={className}>
  <Container size="xl">
    {eyebrow && (
      <Reveal>
        <Badge variant="glass">{eyebrow}</Badge>
      </Reveal>
    )}
    <Reveal delay={eyebrow ? 80 : 0}>
      <Heading level={1} size="display" class="page-intro__title">{title}</Heading>
    </Reveal>
    {lines.length > 0 && (
      <div class="page-intro__description">
        {lines.map((line, index) => (
          <Reveal delay={(eyebrow ? 160 : 80) + index * 60}>
            <p class="text-body-lg text-secondary">{line}</p>
          </Reveal>
        ))}
      </div>
    )}
  </Container>
</Section>

<style>
  .page-intro__title {
    margin-top: var(--space-3);
  }

  .page-intro__description {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
