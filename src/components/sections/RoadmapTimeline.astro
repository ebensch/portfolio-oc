---
/**
 * Visual roadmap: a connected line of dots (vertical on mobile, horizontal
 * from ~900px) rather than a plain definition list — echoes the site's
 * recurring "convergence" line/dot motif (HeroVisual, .bg-dot-grid) without
 * duplicating that SVG.
 */
import Reveal from "../motion/Reveal.astro";
import { roadmap } from "../../data/initiatives";
---

<ol class="roadmap-timeline">
  {roadmap.map((row, index) => (
    <Reveal as="li" delay={80 * index} class="roadmap-timeline__item">
      <span class="roadmap-timeline__dot" aria-hidden="true"></span>
      <div class="roadmap-timeline__body">
        <p class="text-label text-muted roadmap-timeline__period">{row.period}</p>
        <p class="text-body-sm text-secondary">{row.objectives}</p>
      </div>
    </Reveal>
  ))}
</ol>

<style>
  .roadmap-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .roadmap-timeline::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0.28125rem;
    width: 1px;
    background: linear-gradient(180deg, var(--color-border-strong), transparent);
  }

  .roadmap-timeline__item {
    position: relative;
    display: flex;
    gap: var(--space-4);
    padding-left: var(--space-7);
  }

  .roadmap-timeline__dot {
    position: absolute;
    left: 0;
    top: 0.25rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    box-shadow: 0 0 0 4px var(--color-bg-secondary);
  }

  .roadmap-timeline__period {
    margin-bottom: var(--space-1);
  }

  @media (min-width: 900px) {
    .roadmap-timeline {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .roadmap-timeline::before {
      top: 0.28125rem;
      left: 0;
      right: 0;
      bottom: auto;
      height: 1px;
      width: auto;
      background: linear-gradient(
        90deg,
        transparent,
        var(--color-border-strong) 12%,
        var(--color-border-strong) 88%,
        transparent
      );
    }

    .roadmap-timeline__item {
      flex: 1;
      flex-direction: column;
      align-items: center;
      padding-left: 0;
      padding-top: var(--space-6);
      gap: var(--space-2);
    }

    .roadmap-timeline__dot {
      left: 50%;
      top: 0;
      transform: translateX(-50%);
    }

    .roadmap-timeline__body {
      text-align: center;
    }
  }
</style>
