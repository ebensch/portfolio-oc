---
import { mainNav } from "../../data/navigation";
import { site } from "../../data/site";
import Container from "../ui/Container.astro";
import SocialLink from "../ui/SocialLink.astro";
import Divider from "../ui/Divider.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container size="xl">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <span class="footer__logo-mark" aria-hidden="true"></span>
          {site.name}
        </a>
        <p class="text-body-sm footer__tagline">{site.role}</p>
      </div>

      <nav aria-label="Navigation du pied de page" class="footer__nav">
        <ul>
          {mainNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__social">
        <SocialLink href={site.social.linkedin} icon="linkedin">LinkedIn</SocialLink>
        <SocialLink href={`mailto:${site.email}`} icon="mail">{site.email}</SocialLink>
        <SocialLink href={site.phone.href} icon="phone">{site.phone.display}</SocialLink>
      </div>
    </div>

    <Divider class="footer__divider" />

    <div class="footer__bottom">
      <p class="text-caption">© {year} {site.name}. Tous droits réservés.</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-text-inverse);
    padding-block: var(--space-9) var(--space-6);
  }

  .footer__top {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--fw-bold);
  }

  .footer__logo-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gradient-primary);
    flex-shrink: 0;
    animation: footer-mark-pulse 4s ease-in-out infinite;
  }

  @keyframes footer-mark-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .footer__tagline {
    color: var(--color-text-inverse-muted);
    margin-top: var(--space-2);
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .footer__nav a {
    color: var(--color-text-inverse-muted);
    font-size: var(--text-body-sm);
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer__nav a:hover {
    color: var(--color-text-inverse);
  }

  .footer__social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--color-text-inverse-muted);
  }

  .footer__divider {
    background: linear-gradient(90deg, transparent, var(--color-border-glass-dark) 50%, transparent);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: 1.5fr 1fr 1fr;
      align-items: start;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
