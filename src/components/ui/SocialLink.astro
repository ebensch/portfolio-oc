---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  href: string;
  icon: IconName;
  class?: string;
}

const { href, icon, class: className } = Astro.props;
const external = href.startsWith("http");
---

<a
  href={href}
  class:list={["social-link", className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <Icon name={icon} size={18} />
  <span class="social-link__label"><slot /></span>
</a>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--fw-medium);
    color: inherit;
    padding-block: var(--space-1);
  }

  .social-link__label {
    position: relative;
  }

  .social-link__label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .social-link:hover .social-link__label::after,
  .social-link:focus-visible .social-link__label::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
