---
import { cn } from "../../lib/cn";
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  withArrow?: boolean;
  /** Opens in a new tab with `rel="noopener noreferrer"` — for links to external resources. */
  external?: boolean;
  type?: "button" | "submit";
  class?: string;
  "aria-label"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  withArrow = false,
  external = false,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = cn("btn", `btn--${variant}`, `btn--${size}`, className);
---

<Tag
  href={href}
  type={!href ? type : undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={classes}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {withArrow && (
    <span class="btn__arrow" aria-hidden="true">
      <Icon name="arrow-right" size={16} />
    </span>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-width: 100%;
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    border-radius: var(--radius-full);
    white-space: normal;
    text-align: center;
    transition: transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      background var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .btn--md {
    padding: 0.75rem 1.5rem;
    font-size: var(--text-body-sm);
  }

  .btn--lg {
    padding: 1rem 2rem;
    font-size: var(--text-body);
  }

  .btn--primary {
    background: var(--gradient-primary);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  .btn--secondary {
    background: var(--color-surface-glass-strong);
    border: 1px solid var(--color-border-glass);
    color: var(--color-text-primary);
    backdrop-filter: blur(var(--blur-sm));
    -webkit-backdrop-filter: blur(var(--blur-sm));
  }

  @supports not (backdrop-filter: blur(1px)) {
    .btn--secondary {
      background: var(--color-bg-secondary);
    }
  }

  .btn--secondary:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-primary);
    padding-inline: 0;
    border-radius: 0;
  }

  .btn--ghost .btn__label {
    position: relative;
  }

  .btn--ghost .btn__label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0.3);
    transform-origin: left;
    opacity: 0.4;
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-base) var(--ease-out);
  }

  .btn--ghost:hover .btn__label::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .btn__arrow {
    display: inline-flex;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }
</style>
