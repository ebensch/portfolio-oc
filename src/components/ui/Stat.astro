---
/** Small label/value pair — synthetic figures (Veille intro, "De la veille à l'action"...). */
import { cn } from "../../lib/cn";

interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class={cn("stat", className)}>
  <p class="stat__value">{value}</p>
  <p class="text-label text-muted stat__label">{label}</p>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--fw-extrabold);
    color: var(--color-text-primary);
    line-height: var(--lh-tight);
  }
</style>
