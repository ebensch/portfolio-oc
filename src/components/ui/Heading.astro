---
import { cn } from "../../lib/cn";

interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: "display" | "h1" | "h2" | "h3" | "h4";
  gradient?: boolean;
  class?: string;
  id?: string;
}

const { level = 2, size, gradient = false, class: className, id } = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
const visualSize = size ?? (`h${Math.min(level, 4)}` as "h1" | "h2" | "h3" | "h4");
---

<Tag
  id={id}
  class={cn(`text-${visualSize}`, gradient && "text-gradient", className)}
>
  <slot />
</Tag>
