---
import { cn } from "../../lib/cn";

interface Props {
  class?: string;
  /** Tints the pill with an accent color instead of the neutral default. */
  accent?: "rose" | "lavender" | "blue";
}
const { class: className, accent } = Astro.props;
---

<span class={cn("tag", accent && `tag--${accent}`, className)}>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-secondary);
    font-size: var(--text-body-sm);
    font-weight: var(--fw-medium);
    line-height: 1;
  }

  .tag--rose {
    border-color: rgba(217, 139, 163, 0.3);
    background: var(--surface-tint-rose);
    color: var(--color-accent-rose-dark);
  }

  .tag--lavender {
    border-color: rgba(156, 139, 196, 0.3);
    background: var(--surface-tint-lavender);
    color: var(--color-accent-lavender-dark);
  }

  .tag--blue {
    border-color: rgba(143, 179, 217, 0.35);
    background: var(--surface-tint-blue);
    color: var(--color-info);
  }
</style>
