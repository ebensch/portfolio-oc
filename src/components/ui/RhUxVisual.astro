---
interface Props {
  from?: string;
  to?: string;
  class?: string;
}

const { from = "RH", to = "UX", class: className } = Astro.props;
---

<div class:list={["rh-ux-visual", className]} role="img" aria-label={`Reconversion de ${from} vers ${to}`}>
  <div class="rh-ux-visual__glow" aria-hidden="true"></div>

  <span class="rh-ux-visual__circle rh-ux-visual__circle--from">{from}</span>

  <span class="rh-ux-visual__arrow" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 64 24" fill="none" preserveAspectRatio="none">
      <path d="M0 12h56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      <path d="M46 3 60 12 46 21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </span>

  <span class="rh-ux-visual__circle rh-ux-visual__circle--to">{to}</span>
</div>

<style>
  .rh-ux-visual {
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 4cqi, 1rem);
    padding: var(--space-4);
  }

  .rh-ux-visual__glow {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: var(--gradient-mesh);
    filter: blur(var(--blur-lg));
    opacity: 0.9;
  }

  .rh-ux-visual__circle {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(4rem, 32cqi, 6rem);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: var(--fw-extrabold);
    font-size: clamp(1rem, 9cqi, 1.375rem);
    letter-spacing: var(--ls-wide);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border-glass);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .rh-ux-visual__circle--from {
    background: var(--gradient-secondary);
  }

  .rh-ux-visual__circle--to {
    background: var(--gradient-primary);
  }

  .rh-ux-visual:hover .rh-ux-visual__circle--from {
    transform: translateY(-4px);
  }

  .rh-ux-visual:hover .rh-ux-visual__circle--to {
    transform: translateY(4px);
  }

  .rh-ux-visual__arrow {
    flex: 1 1 auto;
    min-width: 1rem;
    max-width: 3rem;
    height: 1.5rem;
    color: var(--color-accent-primary-dark);
  }

  .rh-ux-visual__arrow svg {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .rh-ux-visual__circle {
      transition: none;
    }
  }
</style>
