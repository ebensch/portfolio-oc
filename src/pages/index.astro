import Skills from "../components/sections/Skills.astro";
import CTA from "../components/sections/CTA.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Accueil ${site.name}`} description={site.tagline}>
  <Hero />
  <FeaturedProjects />
  <AboutPreview />
